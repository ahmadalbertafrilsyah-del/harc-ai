            <div className="flex-1 overflow-y-auto p-5 pb-safe">
              <div className="text-[10px] font-bold text-slate-400 uppercase tracking-widest px-1 mb-4">Manajemen Lanjutan</div>
              
              <div className="grid grid-cols-2 gap-4">
