                <th scope="col" className="px-6 py-4 text-center">Tanggal</th>
                <th scope="col" className="px-6 py-4 text-center">Status</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {jurnalList.map((jurnal, idx) => (
